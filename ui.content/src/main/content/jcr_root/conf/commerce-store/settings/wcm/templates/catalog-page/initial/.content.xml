<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        cq:allowedTemplates="[/conf/commerce-store/settings/wcm/templates/product-page,/conf/commerce-store/settings/wcm/templates/category-page]"
        cq:template="/conf/commerce-store/settings/wcm/templates/catalog-page"
        jcr:primaryType="cq:PageContent"
        jcr:title="Catalog Page"
        sling:resourceType="commerce-store/components/commerce/catalogpage">
        <root jcr:primaryType="nt:unstructured" 
            sling:resourceType="commerce-store/components/container">
            <container jcr:primaryType="nt:unstructured" 
                sling:resourceType="commerce-store/components/container">
                <container jcr:primaryType="nt:unstructured" 
                    sling:resourceType="commerce-store/components/container" 
                    layout="responsiveGrid">
                </container>
            </container>
        </root>
    </jcr:content>
</jcr:root>
