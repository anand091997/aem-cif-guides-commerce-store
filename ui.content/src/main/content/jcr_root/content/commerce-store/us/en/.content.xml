<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" 
    xmlns:cq="http://www.day.com/jcr/cq/1.0" 
    xmlns:jcr="http://www.jcp.org/jcr/1.0" 
    xmlns:nt="http://www.jcp.org/jcr/nt/1.0" 
    jcr:primaryType="cq:Page">
    <jcr:content cq:contextHubPath="/etc/cloudsettings/default/contexthub" 
        cq:contextHubSegmentsPath="/etc/segmentation/contexthub" 
        cq:template="/conf/commerce-store/settings/wcm/templates/landing-page" 
        cq:allowedTemplates="[/conf/commerce-store/settings/wcm/templates/page-content,/conf/commerce-store/settings/wcm/templates/catalog-page]"
        cq:cifCategoryPage="/content/commerce-store/us/en/products/category-page" 
        cq:cifProductPage="/content/commerce-store/us/en/products/product-page" 
        cq:cifSearchResultsPage="/content/commerce-store/us/en/search"
        cq:propertyInheritanceCancelled="[jcr:language]"
        jcr:mixinTypes="[cq:LiveRelationship,cq:LiveSync,cq:PropertyLiveSyncCancelled]"
        jcr:primaryType="cq:PageContent" 
        jcr:title="Commerce Store - Home"
        navRoot="{Boolean}true" 
        sling:resourceType="commerce-store/components/page"
        sling:sitemapRoot="{Boolean}true"
        pageTitle="Home">
        <root jcr:primaryType="nt:unstructured"
            jcr:mixinTypes="[cq:LiveRelationship]"
            sling:resourceType="commerce-store/components/container" 
            layout="responsiveGrid">
            <container jcr:primaryType="nt:unstructured"
                jcr:mixinTypes="[cq:LiveRelationship]"
                sling:resourceType="commerce-store/components/container">
                <container jcr:primaryType="nt:unstructured"
                    jcr:mixinTypes="[cq:LiveRelationship]"
                    sling:resourceType="commerce-store/components/container" 
                    layout="responsiveGrid">
                    <heroimage
                        jcr:mixinTypes="[cq:LiveRelationship]" 
                        jcr:primaryType="nt:unstructured" 
                        sling:resourceType="commerce-store/components/heroimage" 
                        fileReference="/content/dam/commerce-store/landing_page_hero.jpg" 
                        heading="All-new reference storefront" 
                        title="commerce-store" />
                </container>
            </container>
        </root>
        <cq:LiveSyncConfig cq:isDeep="{Boolean}true" 
            cq:master="/content/commerce-store/language-masters/en" 
            cq:rolloutConfigs="[/libs/msm/wcm/rolloutconfigs/default]" 
            jcr:primaryType="cq:LiveCopy" />
    </jcr:content>
</jcr:root>
